{
  "name": "giongnoiso",
  "version": "2.0.0",
  "private": true,
  "description": "Ngan hang Giong noi So Bac Trung Bo - he thong tra cuu, dich thuat va luu tru phuong ngu",
  "main": "server.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/migrate.js --seed",
    "create-admin": "node scripts/create-admin.js",
    "check": "node --check server.js && node -e \"require('fs').readdirSync('lib',{recursive:true}).filter(f=>f.endsWith('.js')).forEach(f=>require('child_process').execFileSync(process.execPath,['--check','lib/'+f]))\" && echo OK"
  },
  "dependencies": {
    "mysql2": "^3.11.5"
  }
}
