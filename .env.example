# =============================================================
#  giongnoiso.com - MAU CAU HINH
#  Copy sang .env va dien gia tri that. KHONG BAO GIO commit .env
# =============================================================

# --- Server ---
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
# Dat true khi chay sau nginx/reverse proxy (de doc X-Forwarded-For)
TRUST_PROXY=true
# Dat true khi site chay HTTPS (cookie se co co Secure)
COOKIE_SECURE=true

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# --- Bao mat ---
# Sinh bang: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# So gio hieu luc cua phien dang nhap
SESSION_TTL_HOURS=72
# Cho phep dang ky tai khoan moi tu ngoai (true/false)
ALLOW_REGISTRATION=true

# --- Gioi han ---
MAX_JSON_BODY_BYTES=1048576
MAX_UPLOAD_BODY_BYTES=12582912
MAX_AUDIO_BYTES=8388608

# --- API AI ben ngoai ---
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- Giong noi AI (VieNeu-TTS) ---
TTS_ENABLED=false
TTS_BASE_URL=http://127.0.0.1:7861
# Sinh bang: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TTS_INTERNAL_TOKEN=
TTS_BACKEND=onnx
TTS_MAX_TEXT_CHARS=600
TTS_MAX_CONCURRENCY=1
TTS_CACHE_MAX_BYTES=536870912
# CAN TRONG: bat cai nay cho phep nhan ban giong nguoi dong gop.
# Chi co tac dung voi ban ghi da bat allow_voice_clone trong CSDL.
TTS_ALLOW_CORPUS_CLONING=false
